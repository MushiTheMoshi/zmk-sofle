#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        keys {
            bindings = <
                &kp ESC    &kp N1    &kp N2       &kp N3       &kp N4 &kp N5    &kp UP_ARROW    &kp N6    &kp N7    &kp N8    &kp N9  &kp N0     &kp BACKSPACE
                &kp TAB    &kp Q     &kp W        &kp E        &kp R  &kp T     &kp DOWN_ARROW  &kp Y     &kp U     &kp I     &kp O   &kp P      &kp BSLH
                &kp CAPS   &kp A     &kp S        &kp D        &kp F  &kp G     &kp LEFT_ARROW  &kp H     &kp J     &kp K     &kp L   &kp SEMI   &kp APOS
                &kp LSHFT  &kp Z     &kp X        &kp C        &kp V  &kp B     &kp RIGHT_ARROW &kp N     &kp M     &kp COMMA &kp DOT &kp FSLH   &kp RSHFT
                &kp C_MUTE &kp LCTRL &kp LEFT_GUI &kp LEFT_ALT &mo 1  &kp SPACE &none           &kp SPACE &kp ENTER &mo 4     &mo 2   &kp DELETE

            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "KEYS";
        };

        arrows {
            bindings = <
                &kp GRAVE  &kp F1          &kp F2         &kp F3          &kp F4          &kp F5          &none &kp F6          &kp F7          &kp F8       &kp F9          &kp F10          &trans
                &trans     &kp GRAVE       &mkp LCLK      &mkp MCLK       &mkp RCLK       &mkp MB4        &none &kp PG_UP       &kp PG_DN       &kp HOME     &kp END         &kp MINUS        &kp EQUAL
                &trans     &kp TILDE       &trans         &trans          &trans          &mkp MB5        &none &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW &kp RIGHT_ARROW &kp LEFT_BRACKET &kp RIGHT_BRACKET
                &trans     &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_SPI &rgb_ug RGB_SPD &rgb_ug RGB_EFF &none &rgb_ug RGB_BRI &rgb_ug RGB_BRD &kp INSERT   &kp F11         &kp F12          &trans
                &kp C_MUTE &kp LCTRL       &kp LEFT_GUI   &kp LEFT_ALT    &trans          &kp SPACE       &none &kp SPACE       &kp ENTER       &trans       &trans          &trans

            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "ARROWS";
        };

        config {
            bindings = <
                &kp TILDE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &trans &trans &trans &trans    &trans      &trans
                &trans    &bt BT_CLR   &bt BT_SEL 4 &trans       &trans       &trans       &none &trans &trans &trans &trans    &trans      &trans
                &trans    &out OUT_USB &out OUT_BLE &trans       &trans       &trans       &none &trans &trans &trans &trans    &trans      &trans
                &trans    &sys_reset   &trans       &bootloader  &trans       &trans       &none &trans &trans &trans &soft_off &bootloader &trans
                &trans    &trans       &trans       &trans       &none        &none        &none &trans &trans &trans &trans    &trans

            >;
            display-name = "CONFIG";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        mouse {
            bindings = <
                &none     &none          &none           &none        &none     &none    &none &none          &kp PRSC       &none        &none           &kp C_VOL_DN &kp C_VOL_UP
                &none     &none          &none           &none        &none     &none    &none &none          &mkp LCLK      &mkp RCLK    &none           &kp 786612   &kp 786611
                &none     &mkp LCLK      &mkp MCLK       &mkp RCLK    &mkp LCLK &mkp MB5 &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &kp C_BRI_DN &kp C_BRI_UP
                &kp LSHFT &msc SCRL_LEFT &msc SCRL_RIGHT &none        &none     &none    &none &msc SCRL_DOWN &msc SCRL_UP   &mkp MB4     &mkp MB5        &kp C_PP     &kp 786638
                &none     &kp LCTRL      &kp LEFT_GUI    &kp LEFT_ALT &none     &none    &none &none          &tog 1         &none        &none           &none

            >;
            display-name = "MOUSE";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

    };
};
